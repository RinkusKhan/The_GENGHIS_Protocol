# GENGHIS auth edge (D25 slice 3). Caddy terminates TLS, requires oauth2-proxy auth on every request,
# STRIPS any client-supplied identity headers (anti-spoof), injects the verified ones + the trusted-proxy
# secret, then reverse-proxies to the service.

# Reusable auth wrapper: import genghis_auth <upstream>
(genghis_auth) {
	# oauth2-proxy's own endpoints (login, callback, sign-out) pass straight through.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}
	handle {
		# 1) strip anything a client tried to send — GENGHIS must only ever see proxy-set values.
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Email
		request_header -X-Auth-Request-Groups
		request_header -X-Genghis-Proxy
		# 2) verify the session; on 401 bounce to the login flow; copy the verified identity onward.
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups
			@unauth status 401
			handle_response @unauth {
				redir * /oauth2/start?rd={scheme}://{host}{uri}
			}
		}
		# 3) prove to the coordinator this came through us (matches GENGHIS auth.proxy_secret).
		request_header X-Genghis-Proxy {$PROXY_SECRET}
		reverse_proxy {args[0]}
	}
}

# The Control Room + API + /v1 (coordinator on the host).
{$DOMAIN} {
	import genghis_auth {$COORD_UPSTREAM}
}

# Optional SSO for the other services — give them their own hostnames and uncomment.
# chat.{$DOMAIN}    { import genghis_auth {$CHAT_UPSTREAM} }
# grafana.{$DOMAIN} { import genghis_auth {$GRAFANA_UPSTREAM} }
