# oauth2-proxy + Caddy overlay for GENGHIS (D25 slice 3, self-hosted alternative to Cloudflare).
# Copy to genghis-auth.env and fill in. Values come from your Entra "App registration".
DOMAIN=genghis.example.lan            # the hostname Caddy serves (add to DNS/hosts, or use a real domain for TLS)

# --- Entra ID (Azure AD) app registration ---
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your-client-secret
# Redirect URI to register in Entra:  https://${DOMAIN}/oauth2/callback

# --- oauth2-proxy ---
# 32-byte URL-safe secret:  python -c "import secrets;print(secrets.token_urlsafe(32))"
COOKIE_SECRET=REPLACE-32-byte-random
# The shared secret Caddy sends to the coordinator as X-Genghis-Proxy (== GENGHIS auth.proxy_secret)
PROXY_SECRET=REPLACE-long-random

# Upstreams (where Caddy forwards after auth). The coordinator runs on the HOST; the others are containers.
COORD_UPSTREAM=host.docker.internal:8899
CHAT_UPSTREAM=open-webui:8080
GRAFANA_UPSTREAM=genghis-grafana:3000
